   "evidence": [
    {
     "ocr_line": 1783,
     "page": "p. 23",
     "quote": "Codices in quatuor classes divisimus, quarum primae (A) Casinensem et pervetusti cuiusdam codicis fragmenta ... alteri (B) illos qui sex priores tantum libros habent, tertiae (C) codices tribuimus"
    },
    {
     "ocr_line": 1790,
     "page": "p. 23",
     "quote": "codex Palatinus (C 1) ex quodam classis B codice exscriptus et ope exemplaris integri classis A, cuius interitum iam dolemus, emendatus atque auctus est, aeque ac omnes tertiae classi adscripti libri."
    },
    {
     "ocr_line": 1793,
     "page": "p. 23",
     "quote": "In quartum denique classem (D) reliquos libros collegimus, qui omnes fere a librariis foedissime corrupti sunt neque textum Gregorii integrum conservaverunt"
    },
    {
     "ocr_line": 2400,
     "page": "p. 29",
     "quote": "Cum autem codices omnes B ad idem exemplar hic illic corruptum redeant, quod archetypus, ex quo B 1 et 2 descripti sunt, novis mendis maculavit"
    }
   ],
   "flags": [
    "contamination_at_top",
